{
  "expo": {
    "name": "MENZO",
    "slug": "menzomovil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/app-icon.png",
    "scheme": "menzomovil",
    "userInterfaceStyle": "dark",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07090D",
        "foregroundImage": "./assets/app-icons/android-foreground.png",
        "monochromeImage": "./assets/app-icons/android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sega2028.menzomovil",
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "POST_NOTIFICATIONS"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "ios": {
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Menzo necesita acceder a tu micrófono para las salas de voz.",
        "UIBackgroundModes": ["audio"]
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/branding/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#030509",
          "image": "./assets/branding/splash-mark.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-status-bar",
        {
          "style": "light"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Menzo necesita acceder a tus fotos para que elijas un avatar o compartas una imagen en tus publicaciones.",
          "cameraPermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "947b8f42-65fc-4539-948a-fa8e774a3919"
      }
    }
  }
}
